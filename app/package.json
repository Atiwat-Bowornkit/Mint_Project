{
  "name": "mint-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev:renderer": "vite",
    "build": "vite build",
    "start": "electron .",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env MINT_DEV=1 electron .\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  }
}
